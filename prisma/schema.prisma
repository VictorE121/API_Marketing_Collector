generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CampaignMetric {
  id           Int      @id @default(autoincrement())
  platform     String
  campaignId   String
  campaignName String   @default("")
  date         DateTime
  impressions  Int
  clicks       Int
  spend        Float
  conversions  Int?
  channel      String?
  source       String?
  createdAt    DateTime @default(now())

  @@unique([platform, campaignId, date])
}
